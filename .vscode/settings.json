{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "SConstruct": "python",
    "SConscript": "python",
    "*.capnp": "capnp",
    "*.pyx": "cython",
    "*.pxd": "cython"
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "python.defaultInterpreterPath": ".venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/openpilot"
  ],
  "gitlens.codeLens.authors.enabled": true,
  "githubPullRequests.remotes": [
    "fork",
    "origin"
  ]
}
