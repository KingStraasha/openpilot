{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "SConstruct": "python",
    "SConscript": "python",
    "*.capnp": "capnp",
    "*.pyx": "cython",
    "*.pxd": "cython",
    "*.dbc": "plaintext"
  },
  "search.exclude": {
    "**/.git": true,
    "**/__pycache__": true,
    "**/.sconsign.dblite": true,
    "**/.hypothesis": true,
    "**/.cache": true,
    "**/*.o": true,
    "**/*.os": true,
    "**/*.so": true,
    "**/*.a": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/__pycache__": true,
    "**/.sconsign.dblite": true,
    "**/.hypothesis": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.cache/**": true,
    "**/.hypothesis/**": true,
    "**/.venv/**": false
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "python.defaultInterpreterPath": ".venv/bin/python",
  "python.venvPath": ".",
  "python.venvFolders": [
    ".venv"
  ],
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "*test*.py"
  ],
  "python.analysis.extraPaths": [
    ".",
    "opendbc_repo",
    "openpilot",
    "sunnypilot",
    "msgq_repo",
    "rednose_repo",
    "teleoprtc_repo",
    "tinygrad_repo"
  ],
  "python.autoComplete.extraPaths": [
    ".",
    "opendbc_repo",
    "openpilot",
    "sunnypilot",
    "msgq_repo",
    "rednose_repo",
    "teleoprtc_repo",
    "tinygrad_repo"
  ],
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": [
    ".",
    "**",
    "opendbc_repo/**",
    "panda/**",
    "msgq_repo/**",
    "rednose_repo/**",
    "tinygrad_repo/**"
  ],
  "C_Cpp.default.compileCommands": "compile_commands.json",
  "gitlens.codeLens.authors.enabled": true,
  "githubPullRequests.remotes": [
    "fork",
    "origin"
  ],
  "antigravity.agent.provider": "antigravity-2.0",
  "antigravity.agent.useLocalDaemon": true,
  "antigravity.agent.daemonPort": 45481,
  "antigravity.agent.daemonHttpPort": 39927,
  "git.autofetch": "all",
  "git.autofetchPeriod": 180,
  "git.autoStash": true,
  "git.confirmSync": false,
  "git.pullBeforeCheckout": true
}
