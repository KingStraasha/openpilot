{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "SConstruct": "python",
    "SConscript": "python",
    "*.capnp": "capnp",
    "*.pyx": "cython",
    "*.pxd": "cython",
    "*.dbc": "plaintext"
  },
  "search.exclude": {
    "**/.git": true,
    "**/__pycache__": true,
    "**/.sconsign.dblite": true,
    "**/.hypothesis": true,
    "**/.cache": true,
    "**/*.o": true,
    "**/*.os": true,
    "**/*.so": true,
    "**/*.a": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/__pycache__": true,
    "**/.sconsign.dblite": true,
    "**/.hypothesis": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.cache/**": true,
    "**/.hypothesis/**": true,
    "**/.venv/**": false
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.interpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.venvPath": "${workspaceFolder}",
  "python.venvFolders": [
    ".venv"
  ],
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestPath": "${workspaceFolder}/.venv/bin/pytest",
  "python.testing.pytestArgs": [
    "openpilot"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/opendbc_repo",
    "${workspaceFolder}/openpilot",
    "${workspaceFolder}/sunnypilot"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/opendbc_repo",
    "${workspaceFolder}/openpilot",
    "${workspaceFolder}/sunnypilot"
  ],
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "${workspaceFolder}/**",
    "${workspaceFolder}/opendbc_repo/**",
    "${workspaceFolder}/panda/**",
    "${workspaceFolder}/msgq_repo/**",
    "${workspaceFolder}/rednose_repo/**",
    "${workspaceFolder}/tinygrad_repo/**"
  ],
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
  "gitlens.codeLens.authors.enabled": true,
  "githubPullRequests.remotes": [
    "fork",
    "origin"
  ],
  "antigravity.agent.provider": "antigravity-2.0",
  "antigravity.agent.useLocalDaemon": true,
  "antigravity.agent.daemonPort": 45481,
  "antigravity.agent.daemonHttpPort": 39927
}
